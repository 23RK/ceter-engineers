generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  DONE
  CANCELED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum LeadStatus {
  IN_PROGRESS
  PENDING
  WON
  LOST
}

// The single shared company login. There is normally just one row here -
// both partners sign in with the same company email + password.
model Credential {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

// A partner's profile. Not a login - after signing in with the shared
// Credential, each partner picks their own profile so tasks/activity can
// be attributed to the right person.
model User {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#2563eb")
  createdAt DateTime @default(now())

  assignedTasks Task[]        @relation("AssignedTasks")
  createdTasks  Task[]        @relation("CreatedTasks")
  activities    Activity[]
}

model Project {
  id          String        @id @default(cuid())
  name        String
  client      String?
  address     String?
  status      ProjectStatus @default(PLANNING)
  description String?
  budget      Float?
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tasks      Task[]
  milestones Milestone[]
  activities Activity[]
}

model Milestone {
  id        String    @id @default(cuid())
  title     String
  dueDate   DateTime?
  done      Boolean   @default(false)
  order     Int       @default(0)
  createdAt DateTime  @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  startDate   DateTime?
  order       Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String?

  assignee   User?   @relation("AssignedTasks", fields: [assigneeId], references: [id])
  assigneeId String?

  createdBy   User   @relation("CreatedTasks", fields: [createdById], references: [id])
  createdById String
}

// A prospective new project we're chasing (business development), kept
// separate from Project (existing, won work being executed).
model Lead {
  id        String     @id @default(cuid())
  name      String // client / developer name
  status    LeadStatus @default(IN_PROGRESS)
  notes     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  tasks LeadTask[]
}

model LeadTask {
  id        String     @id @default(cuid())
  title     String // free text - not a closed list
  status    TaskStatus @default(TODO)
  dueDate   DateTime?
  order     Int        @default(0)
  createdAt DateTime   @default(now())

  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId String
}

model Activity {
  id        String   @id @default(cuid())
  message   String
  createdAt DateTime @default(now())

  actor   User?   @relation(fields: [actorId], references: [id])
  actorId String?

  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String?
}
