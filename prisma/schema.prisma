generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  DONE
  CANCELED
}

// Which department runs a project (SPEC §3.1). בדק בית is a separate table
// (stage 3), not a Project department. Nullable only for existing projects
// still waiting to be assigned on the "שיוך מחלקות" screen (/projects).
enum Department {
  DEVELOPER // ניהול ופיקוח – יזמים
  VILLA // ניהול ופיקוח – וילות
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum LeadStatus {
  IN_PROGRESS
  PENDING
  WON
  LOST
}

enum UserRole {
  ADMIN // reserved - no admin user for now (only רון and גיא sign in)
  PARTNER // רון / גיא - shown in assignee lists, syncs a Google Calendar
}

enum GoogleSyncStatus {
  SYNCED
  ERROR
}

// A person who can sign in, with their own email + password. Only rows
// with both an email and a password can sign in.
model User {
  id        String   @id @default(cuid())
  name      String
  email     String?  @unique // always stored lower-case
  role      UserRole @default(PARTNER)
  color     String   @default("#2563eb")
  createdAt DateTime @default(now())

  passwordHash      String? // bcrypt
  // Sessions signed in before this moment are rejected (sign out everywhere
  // on password change).
  passwordChangedAt DateTime?
  // Brute-force protection: too many wrong passwords lock the account briefly.
  failedLoginCount  Int       @default(0)
  lockedUntil       DateTime?

  assignedTasks Task[]              @relation("AssignedTasks")
  createdTasks  Task[]              @relation("CreatedTasks")
  activities    Activity[]
  meetings      Meeting[]
  googleAccount GoogleAccount?
  meetingSyncs  MeetingGoogleSync[]
}

model Project {
  id          String        @id @default(cuid())
  name        String
  client      String?
  address     String?
  status      ProjectStatus @default(PLANNING)
  department  Department?
  description String?
  budget      Float?
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tasks      Task[]
  milestones Milestone[]
  activities Activity[]

  @@index([department])
}

model Milestone {
  id        String    @id @default(cuid())
  title     String
  dueDate   DateTime?
  done      Boolean   @default(false)
  order     Int       @default(0)
  createdAt DateTime  @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  startDate   DateTime?
  order       Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String?

  assignee   User?   @relation("AssignedTasks", fields: [assigneeId], references: [id])
  assigneeId String?

  createdBy   User   @relation("CreatedTasks", fields: [createdById], references: [id])
  createdById String
}

// A prospective new project we're chasing (business development), kept
// separate from Project (existing, won work being executed).
model Lead {
  id        String     @id @default(cuid())
  name      String // client / developer name
  status    LeadStatus @default(IN_PROGRESS)
  notes     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  tasks LeadTask[]
}

model LeadTask {
  id        String     @id @default(cuid())
  title     String // free text - not a closed list
  status    TaskStatus @default(TODO)
  dueDate   DateTime?
  order     Int        @default(0)
  createdAt DateTime   @default(now())

  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId String

  // Optional link to a scheduled meeting (e.g. a "קביעת פגישה" task).
  meeting   Meeting? @relation(fields: [meetingId], references: [id])
  meetingId String?  @unique
}

model Meeting {
  id          String   @id @default(cuid())
  title       String
  description String?
  location    String?
  startTime   DateTime
  endTime     DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String

  leadTask LeadTask?
  syncs    MeetingGoogleSync[]
}

// One row per partner whose Google Calendar is synced - created when they
// connect it from Settings. Access/refresh tokens are stored encrypted (see
// src/lib/crypto.ts). `googleEmail` is restricted by a DB CHECK constraint
// (migration 20261102120000_password_login) to the two partner accounts,
// and the app additionally requires it to equal the owning user's email.
model GoogleAccount {
  id                    String    @id @default(cuid())
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                String    @unique
  googleEmail           String
  encryptedAccessToken  String
  encryptedRefreshToken String
  accessTokenExpiresAt  DateTime
  // Always "primary" - the partner's main Google Calendar.
  calendarId            String    @default("primary")
  lastSyncedAt          DateTime?
  createdAt             DateTime  @default(now())
}

// One row per partner whose Google Calendar a given Meeting is pushed to -
// two partners can each have their own copy of the same meeting.
model MeetingGoogleSync {
  id            String           @id @default(cuid())
  meeting       Meeting          @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  meetingId     String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  googleEventId String
  googleUpdated DateTime? // Google's `updated` timestamp - used for last-write-wins
  status        GoogleSyncStatus @default(SYNCED)

  @@unique([meetingId, userId])
  @@unique([userId, googleEventId])
}

model Activity {
  id        String   @id @default(cuid())
  message   String
  createdAt DateTime @default(now())

  actor   User?   @relation(fields: [actorId], references: [id])
  actorId String?

  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String?
}
