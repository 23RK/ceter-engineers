generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  DONE
  CANCELED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum LeadStatus {
  IN_PROGRESS
  PENDING
  WON
  LOST
}

enum GoogleSyncStatus {
  SYNCED
  ERROR
}

// The single shared company login. There is normally just one row here -
// both partners sign in with the same company email + password.
model Credential {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

// A partner's profile. Not a login - after signing in with the shared
// Credential, each partner picks their own profile so tasks/activity can
// be attributed to the right person.
model User {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#2563eb")
  createdAt DateTime @default(now())

  assignedTasks Task[]        @relation("AssignedTasks")
  createdTasks  Task[]        @relation("CreatedTasks")
  activities    Activity[]
  meetings      Meeting[]
  googleAccount GoogleAccount?
  meetingSyncs  MeetingGoogleSync[]
}

model Project {
  id          String        @id @default(cuid())
  name        String
  client      String?
  address     String?
  status      ProjectStatus @default(PLANNING)
  description String?
  budget      Float?
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tasks      Task[]
  milestones Milestone[]
  activities Activity[]
}

model Milestone {
  id        String    @id @default(cuid())
  title     String
  dueDate   DateTime?
  done      Boolean   @default(false)
  order     Int       @default(0)
  createdAt DateTime  @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  startDate   DateTime?
  order       Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String?

  assignee   User?   @relation("AssignedTasks", fields: [assigneeId], references: [id])
  assigneeId String?

  createdBy   User   @relation("CreatedTasks", fields: [createdById], references: [id])
  createdById String
}

// A prospective new project we're chasing (business development), kept
// separate from Project (existing, won work being executed).
model Lead {
  id        String     @id @default(cuid())
  name      String // client / developer name
  status    LeadStatus @default(IN_PROGRESS)
  notes     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  tasks LeadTask[]
}

model LeadTask {
  id        String     @id @default(cuid())
  title     String // free text - not a closed list
  status    TaskStatus @default(TODO)
  dueDate   DateTime?
  order     Int        @default(0)
  createdAt DateTime   @default(now())

  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId String

  // Optional link to a scheduled meeting (e.g. a "קביעת פגישה" task).
  meeting   Meeting? @relation(fields: [meetingId], references: [id])
  meetingId String?  @unique
}

model Meeting {
  id          String   @id @default(cuid())
  title       String
  description String?
  location    String?
  startTime   DateTime
  endTime     DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String

  leadTask LeadTask?
  syncs    MeetingGoogleSync[]
}

// One row per partner who has connected their Gmail account for Calendar
// sync. Access/refresh tokens are stored encrypted (see src/lib/crypto.ts).
model GoogleAccount {
  id                    String   @id @default(cuid())
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                String   @unique
  googleEmail           String
  encryptedAccessToken  String
  encryptedRefreshToken String
  accessTokenExpiresAt  DateTime
  calendarId            String   @default("primary")
  lastSyncedAt          DateTime?
  createdAt             DateTime @default(now())
}

// One row per partner whose Google Calendar a given Meeting is pushed to -
// two partners can each have their own copy of the same meeting.
model MeetingGoogleSync {
  id            String           @id @default(cuid())
  meeting       Meeting          @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  meetingId     String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  googleEventId String
  googleUpdated DateTime? // Google's `updated` timestamp - used for last-write-wins
  status        GoogleSyncStatus @default(SYNCED)

  @@unique([meetingId, userId])
  @@unique([userId, googleEventId])
}

model Activity {
  id        String   @id @default(cuid())
  message   String
  createdAt DateTime @default(now())

  actor   User?   @relation(fields: [actorId], references: [id])
  actorId String?

  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String?
}
