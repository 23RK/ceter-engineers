generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  DONE
  CANCELED
}

// Which department runs a project (SPEC §3.1). בדק בית is a separate table
// (stage 3), not a Project department. Nullable only for existing projects
// still waiting to be assigned on the "שיוך מחלקות" screen (/projects).
enum Department {
  DEVELOPER // ניהול ופיקוח – יזמים
  VILLA // ניהול ופיקוח – וילות
}

// A project stage's progress (SPEC §3.3).
enum StageStatus {
  NOT_STARTED // לא התחיל
  IN_PROGRESS // בביצוע
  DONE // הושלם
}

// שכר טרחה: how a project's fee is set (SPEC §3.5).
enum FeeModel {
  MILESTONES // סכום כולל לפי אבני דרך
  RETAINER // ריטיינר חודשי
  PERCENTAGE // אחוז מעלות הבנייה
}

// A contact's role in a project (SPEC §3.4 "אנשי קשר").
enum ContactRole {
  CLIENT // לקוח
  DEVELOPER // יזם
  CONTRACTOR // קבלן מבצע
  ARCHITECT // אדריכל
  ENGINEER // מהנדס
  CONSULTANT // יועץ
  OTHER // אחר
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum LeadStatus {
  IN_PROGRESS
  PENDING
  WON
  LOST
}

enum UserRole {
  ADMIN // reserved - no admin user for now (only רון and גיא sign in)
  PARTNER // רון / גיא - shown in assignee lists, syncs a Google Calendar
}

enum GoogleSyncStatus {
  SYNCED
  ERROR
}

// A person who can sign in, with their own email + password. Only rows
// with both an email and a password can sign in.
model User {
  id        String   @id @default(cuid())
  name      String
  email     String?  @unique // always stored lower-case
  role      UserRole @default(PARTNER)
  color     String   @default("#2563eb")
  createdAt DateTime @default(now())

  ownedProjects Project[] @relation("ProjectOwner")

  passwordHash      String? // bcrypt
  // Sessions signed in before this moment are rejected (sign out everywhere
  // on password change).
  passwordChangedAt DateTime?
  // Brute-force protection: too many wrong passwords lock the account briefly.
  failedLoginCount  Int       @default(0)
  lockedUntil       DateTime?

  assignedTasks Task[]              @relation("AssignedTasks")
  createdTasks  Task[]              @relation("CreatedTasks")
  activities    Activity[]
  meetings      Meeting[]
  googleAccount GoogleAccount?
  meetingSyncs  MeetingGoogleSync[]

  projectUpdates     ProjectUpdate[]
  uploadedFiles      ProjectFile[]
  supervisionReports SupervisionReport[]
  notifications      Notification[]      @relation("NotificationRecipient")
  sentNotifications  Notification[]      @relation("NotificationActor")
}

model Project {
  id          String        @id @default(cuid())
  name        String
  client      String?
  address     String?
  city        String?
  status      ProjectStatus @default(PLANNING)
  department  Department?
  description String?
  budget      Float?
  startDate   DateTime?
  endDate     DateTime?
  // Moved to the archive by hand ("העבר לארכיון"). Projects that are הושלם /
  // בוטל are in the archive too - see isArchived() in src/lib/project-list.ts.
  archivedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // אחראי (רון / גיא)
  owner   User?   @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  ownerId String?

  // שכר טרחה (SPEC §3.5). Which fields apply depends on feeModel; amounts in ₪.
  feeModel            FeeModel?
  feeTotal            Float? // MILESTONES: סכום כולל
  feeMonthly          Float? // RETAINER: סכום לחודש
  feeStartDate        DateTime? // RETAINER: תאריך התחלה
  feeEndDate          DateTime? // RETAINER: תאריך סיום
  feePercent          Float? // PERCENTAGE: אחוז
  feeConstructionCost Float? // PERCENTAGE: עלות בנייה משוערת
  feeNotes            String?

  tasks              Task[]
  milestones         Milestone[]
  activities         Activity[]
  payments           Payment[]
  updates            ProjectUpdate[]
  files              ProjectFile[]
  contacts           ProjectContact[]
  supervisionReports SupervisionReport[]
  changeOrders       ChangeOrder[]
  notifications      Notification[]

  @@index([department])
  @@index([ownerId])
  @@index([archivedAt])
}

// A project stage (shown as "שלב" in the UI). dueDate is the planned date,
// completedAt the actual date. `done` is kept in sync with status == DONE for
// backward compatibility (it can be dropped later, with approval).
model Milestone {
  id          String      @id @default(cuid())
  title       String
  dueDate     DateTime?
  done        Boolean     @default(false)
  status      StageStatus @default(NOT_STARTED)
  completedAt DateTime?
  order       Int         @default(0)
  createdAt   DateTime    @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  payments Payment[]

  @@index([projectId, order])
}

// One row of a project's לוח גבייה (SPEC §3.5). A payment can be tied to a
// stage: when that stage is done and the payment isn't paid, the app alerts.
model Payment {
  id            String    @id @default(cuid())
  title         String?
  amount        Float
  dueDate       DateTime?
  invoiceIssued Boolean   @default(false) // חשבונית הוצאה
  paid          Boolean   @default(false)
  paidAt        DateTime?
  order         Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  stage     Milestone? @relation(fields: [stageId], references: [id], onDelete: SetNull)
  stageId   String?

  @@index([projectId, order])
  @@index([stageId])
}

// A note in a project's "עדכונים" thread, with attachments; tagging a partner
// creates a Notification for them.
model ProjectUpdate {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  author    User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId  String?

  files         ProjectFile[]
  notifications Notification[]

  @@index([projectId, createdAt])
}

// A project document: an uploaded file (bytes in ProjectFileData) or a link
// (e.g. Google Drive). Attachments of an update have updateId set.
model ProjectFile {
  id        String   @id @default(cuid())
  name      String
  url       String? // a link instead of an upload
  mimeType  String?
  size      Int?
  createdAt DateTime @default(now())

  project      Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId    String
  update       ProjectUpdate? @relation(fields: [updateId], references: [id], onDelete: Cascade)
  updateId     String?
  uploadedBy   User?          @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedById String?

  data ProjectFileData?

  @@index([projectId, createdAt])
  @@index([updateId])
}

// The bytes of an uploaded file, kept apart so lists never load them.
model ProjectFileData {
  file   ProjectFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  fileId String      @id
  data   Bytes
}

// The general contacts list (מאגר אנשי קשר). Projects link to it.
model Contact {
  id        String   @id @default(cuid())
  name      String
  company   String?
  phone     String?
  email     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects ProjectContact[]

  @@index([name])
}

model ProjectContact {
  id        String      @id @default(cuid())
  role      ContactRole
  roleNote  String? // e.g. "יועץ חשמל"
  createdAt DateTime    @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId String

  @@unique([projectId, contactId, role])
  @@index([contactId])
}

// יזמים: דוחות פיקוח (SPEC §3.4).
model SupervisionReport {
  id              String   @id @default(cuid())
  visitDate       DateTime
  performedByName String? // someone who isn't a partner
  reportSent      Boolean  @default(false)
  fileUrl         String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project       Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId     String
  performedBy   User?   @relation(fields: [performedById], references: [id], onDelete: SetNull)
  performedById String?

  @@index([projectId, visitDate])
}

// וילות: שינויים ותוספות (SPEC §3.4).
model ChangeOrder {
  id             String    @id @default(cuid())
  description    String
  cost           Float?
  clientApproved Boolean   @default(false)
  date           DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  @@index([projectId])
}

// An in-app notification (e.g. a partner was tagged in an update).
model Notification {
  id        String    @id @default(cuid())
  message   String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user      User           @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  actor     User?          @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorId   String?
  project   Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String?
  update    ProjectUpdate? @relation(fields: [updateId], references: [id], onDelete: Cascade)
  updateId  String?

  @@index([userId, readAt, createdAt])
  @@index([updateId])
}

// The default stages a new project of a department starts with (SPEC §3.3).
// Edited in Settings; changes apply to new projects only.
model StageTemplate {
  id         String     @id @default(cuid())
  department Department
  title      String
  order      Int
  createdAt  DateTime   @default(now())

  @@index([department, order])
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  startDate   DateTime?
  order       Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String?

  assignee   User?   @relation("AssignedTasks", fields: [assigneeId], references: [id])
  assigneeId String?

  createdBy   User   @relation("CreatedTasks", fields: [createdById], references: [id])
  createdById String
}

// A prospective new project we're chasing (business development), kept
// separate from Project (existing, won work being executed).
model Lead {
  id        String     @id @default(cuid())
  name      String // client / developer name
  status    LeadStatus @default(IN_PROGRESS)
  notes     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  tasks LeadTask[]
}

model LeadTask {
  id        String     @id @default(cuid())
  title     String // free text - not a closed list
  status    TaskStatus @default(TODO)
  dueDate   DateTime?
  order     Int        @default(0)
  createdAt DateTime   @default(now())

  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId String

  // Optional link to a scheduled meeting (e.g. a "קביעת פגישה" task).
  meeting   Meeting? @relation(fields: [meetingId], references: [id])
  meetingId String?  @unique
}

model Meeting {
  id          String   @id @default(cuid())
  title       String
  description String?
  location    String?
  startTime   DateTime
  endTime     DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String

  leadTask LeadTask?
  syncs    MeetingGoogleSync[]
}

// One row per partner whose Google Calendar is synced - created when they
// connect it from Settings. Access/refresh tokens are stored encrypted (see
// src/lib/crypto.ts). `googleEmail` is restricted by a DB CHECK constraint
// (migration 20261102120000_password_login) to the two partner accounts,
// and the app additionally requires it to equal the owning user's email.
model GoogleAccount {
  id                    String    @id @default(cuid())
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                String    @unique
  googleEmail           String
  encryptedAccessToken  String
  encryptedRefreshToken String
  accessTokenExpiresAt  DateTime
  // Always "primary" - the partner's main Google Calendar.
  calendarId            String    @default("primary")
  lastSyncedAt          DateTime?
  createdAt             DateTime  @default(now())
}

// One row per partner whose Google Calendar a given Meeting is pushed to -
// two partners can each have their own copy of the same meeting.
model MeetingGoogleSync {
  id            String           @id @default(cuid())
  meeting       Meeting          @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  meetingId     String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  googleEventId String
  googleUpdated DateTime? // Google's `updated` timestamp - used for last-write-wins
  status        GoogleSyncStatus @default(SYNCED)

  @@unique([meetingId, userId])
  @@unique([userId, googleEventId])
}

model Activity {
  id        String   @id @default(cuid())
  message   String
  createdAt DateTime @default(now())

  actor   User?   @relation(fields: [actorId], references: [id])
  actorId String?

  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String?
}
