# A managed Postgres connection string (e.g. from Neon, Supabase, or Vercel
# Postgres). For local development you can also point this at a local
# Postgres instance: postgresql://postgres:postgres@localhost:5432/keter
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

SESSION_SECRET="replace-with-a-long-random-string"

# --- Google Calendar sync (optional) ---
# All four are required together for the "יומן פגישות" page to sync with
# Google Calendar; the calendar still works as a plain shared calendar
# without them. See the README's "חיבור Google Calendar" section.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Full deployed URL, no trailing slash - must match the OAuth redirect URI
# configured in Google Cloud Console (<APP_URL>/api/google/callback).
APP_URL="https://your-app.vercel.app"
# 32-byte key, hex-encoded (64 hex chars) - encrypts Google tokens at rest.
TOKEN_ENCRYPTION_KEY="replace-with-a-64-char-hex-string"
