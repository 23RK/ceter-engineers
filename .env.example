# A managed Postgres connection string (e.g. from Neon, Supabase, or Vercel
# Postgres). For local development you can also point this at a local
# Postgres instance: postgresql://postgres:postgres@localhost:5432/keter
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

SESSION_SECRET="replace-with-a-long-random-string"
