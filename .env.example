# A managed Postgres connection string (e.g. from Neon). For local
# development you can also point this at a local Postgres instance:
# postgresql://postgres:postgres@localhost:5432/keter
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Signs the session cookie. A long random string (40+ chars).
SESSION_SECRET="replace-with-a-long-random-string"

# Initial passwords (temporary). Set only for a user who has no password yet,
# at deploy time (prisma/seed.ts). Remove them once each partner has changed
# their password in Settings. At least 8 characters.
INITIAL_PASSWORD_RON=""
INITIAL_PASSWORD_GUY=""

# --- Google Calendar connection (Settings -> "חיבור יומן Google") ---
# Sign-in doesn't need these; without them the calendar just isn't connectable.
# From Google Cloud Console -> Credentials -> OAuth client (Web application).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Full deployed URL, no trailing slash. The OAuth redirect URI configured in
# Google Cloud Console must be exactly <APP_URL>/api/google/callback
# (for local development: http://localhost:3000).
APP_URL="https://your-app.vercel.app"
# 32-byte key, hex-encoded (64 hex chars) - encrypts Google tokens at rest.
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY="replace-with-a-64-char-hex-string"
